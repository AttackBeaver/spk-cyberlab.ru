datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Роли пользователей
enum Role {
  GUEST
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id             Int          @id @default(autoincrement())
  username       String?      @unique
  email          String?      @unique
  passwordHash   String?      // null до активации
  fullName       String
  role           Role         @default(STUDENT)
  group          Group?       @relation(fields: [groupId], references: [id])
  groupId        Int?
  studentNumber  Int?         // номер по списку
  createdAt      DateTime     @default(now())
  lastLogin      DateTime?    @updatedAt
  // связи
  taskAttempts   TaskAttempt[]
  memes          Meme[]
  achievements   UserAchievement[]
  createdCourses Course[]     @relation("TeacherCourses")
  sandboxSessions SandboxSession[]
  logs           Log[]
  news           News[]
  bugReports      BugReport[]     @relation("UserBugReports")
  bugReportsResponded BugReport[] @relation("ResponderBugReports")
  memeVotes      MemeVote[]   // <--- добавлено
}

model Group {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  prefix       String?
  year         Int
  students     User[]
  createdAt    DateTime @default(now())
}

model Course {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  teacherId    Int
  teacher      User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  modules      Module[]
  createdAt    DateTime @default(now())
}

model Module {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  order        Int
  courseId     Int
  course       Course   @relation(fields: [courseId], references: [id])
  topics       Topic[]
}

model Topic {
  id           Int      @id @default(autoincrement())
  title        String
  content      String?
  order        Int
  moduleId     Int
  module       Module   @relation(fields: [moduleId], references: [id])
  tasks        Task[]
}

model Task {
  id               Int            @id @default(autoincrement())
  title            String
  description      String
  type             TaskType
  solutionTemplate String?
  difficulty       Int            @default(1)
  timeLimit        Int?
  attemptsLimit    Int?
  topicId          Int
  topic            Topic          @relation(fields: [topicId], references: [id])
  attempts         TaskAttempt[]
  sandboxSessions  SandboxSession[]
}

enum TaskType {
  TEXT
  SQL_INJECTION
  XSS
  CRYPTO_ANALYSIS
  CODE
}

model TaskAttempt {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  taskId       Int
  task         Task          @relation(fields: [taskId], references: [id])
  answer       String?
  score        Float?
  status       AttemptStatus @default(PENDING)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
}

enum AttemptStatus {
  PENDING
  PASSED
  FAILED
  TIME_EXPIRED
}

model SandboxSession {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  taskId       Int
  task         Task          @relation(fields: [taskId], references: [id])
  containerId  String?
  status       SandboxStatus @default(ACTIVE)
  startedAt    DateTime      @default(now())
  expiredAt    DateTime?
}

enum SandboxStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Meme {
  id           Int        @id @default(autoincrement())
  title        String
  imageUrl     String
  category     MemeCategory?  @default(OTHER)
  authorId     Int
  author       User       @relation(fields: [authorId], references: [id])
  approved     Boolean    @default(false)
  approvedBy   Int?
  createdAt    DateTime   @default(now())
  likes        Int        @default(0)
  dislikes     Int        @default(0)
  votes        MemeVote[] // <--- добавлено
}

model Achievement {
  id               Int               @id @default(autoincrement())
  name             String
  description      String
  icon             String
  criteria         String?
  userAchievements UserAchievement[]
}

model UserAchievement {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  achievementId  Int
  achievement    Achievement  @relation(fields: [achievementId], references: [id])
  earnedAt       DateTime     @default(now())
}

model Log {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  details      String?
  ip           String?
  createdAt    DateTime @default(now())
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  published Boolean  @default(false)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BugReport {
  id            Int             @id @default(autoincrement())
  title         String
  description   String
  steps         String?
  severity      BugSeverity     @default(MEDIUM)
  category      BugCategory?
  status        BugStatus       @default(NEW)
  userId        Int
  user          User            @relation("UserBugReports", fields: [userId], references: [id])
  adminResponse String?
  respondedBy   Int?
  responder     User?           @relation("ResponderBugReports", fields: [respondedBy], references: [id])
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugCategory {
  UI
  SECURITY
  PERFORMANCE
  OTHER
}

enum BugStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  WONTFIX
  CLOSED
}

enum MemeCategory {
  PHOTO
  VIDEO
  OTHER
}

model MemeVote {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  memeId    Int
  meme      Meme      @relation(fields: [memeId], references: [id])
  voteType  VoteType
  createdAt DateTime  @default(now())

  @@unique([userId, memeId])
}

enum VoteType {
  LIKE
  DISLIKE
}